<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="LittleGuy3000.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Little Guy 3000">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="Root_KeyDown">
  <Grid.Resources>
   <SolidColorBrush x:Key="AccentBrush" Color="#DDEC9A"/>
   <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="DragRegion" Padding="22,0,130,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}"/>
    <TextBlock Text="LITTLE GUY 3000" FontSize="12" CharacterSpacing="160" FontWeight="SemiBold"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Padding="20,4,20,12">
   <StackPanel Orientation="Horizontal" Spacing="4">
    <Button Content="Ask Little Guy" Style="{StaticResource QuietButton}" Click="AskTab_Click"/>
    <Button Content="Settings" Style="{StaticResource QuietButton}" Click="SettingsTab_Click"/>
    <Button Content="History" Style="{StaticResource QuietButton}" Click="HistoryTab_Click"/>
   </StackPanel>
   <ToggleButton x:Name="PinToggle" HorizontalAlignment="Right" Content="Pin" AutomationProperties.Name="Keep answer panel visible"/>
  </Grid>
  <Grid Grid.Row="2" x:Name="AskPanel" Padding="26,0,26,0">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18" Padding="0,0,0,18">
     <StackPanel x:Name="WelcomePanel" Spacing="8" Margin="0,18,0,12">
      <Image x:Name="MascotImage" Width="118" Height="118" HorizontalAlignment="Left" AutomationProperties.Name="Little Guy, a friendly animated smiley"/>
      <TextBlock Text="A little help.&#10;Right where you are." FontSize="34" FontWeight="SemiBold" LineHeight="40" TextWrapping="Wrap"/>
      <TextBlock Text="Point. Ask. Know." FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
      <TextBlock Text="Hover over a control, press the shortcut, and ask. Little Guy can explain it, point it out, or walk you through it." FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,8"/>
      <Button x:Name="SetupButton" Content="Set up Little Guy  →" Click="SettingsTab_Click" Padding="18,10"/>
     </StackPanel>
     <Border x:Name="ContextBadge" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9">
      <TextBlock x:Name="ContextText" Text="Text only · no screen attached" FontSize="12" TextTrimming="CharacterEllipsis"/>
     </Border>
     <TextBlock x:Name="QuestionText" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="AnswerText" FontSize="16" LineHeight="25" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
      <Button Content="Show me" Click="ShowMe_Click"/>
      <Button Content="Walk me through it" Click="Walkthrough_Click"/>
      <Button Content="Copy" Click="Copy_Click"/><Button Content="Pin answer" Click="PinAnswer_Click"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="WalkthroughButtons" Grid.Row="1" Visibility="Collapsed" Padding="12" CornerRadius="10" Background="#272D24" BorderBrush="#566348" BorderThickness="1" Margin="0,8,0,8">
    <StackPanel Spacing="8">
     <TextBlock x:Name="WalkthroughText" Foreground="#ECF4D8" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <StackPanel x:Name="WalkthroughStepActions" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button x:Name="DoneStepButton" Content="Check step →" Click="Done_Click" Background="{StaticResource AccentBrush}" Foreground="#20271E"/>
       <Button Content="Explain" Click="Explain_Click"/><Button Content="Repeat" Click="Repeat_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button x:Name="BackStepButton" Content="Back" Click="Back_Click"/><Button Content="Skip" Click="Skip_Click"/>
      </StackPanel>
     </StackPanel>
     <Button Content="End walkthrough" Click="EndWalkthrough_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/>
    </StackPanel>
   </Border>
   <Border x:Name="Notice" Grid.Row="2" Visibility="Collapsed" Background="#29271D" BorderBrush="#A99756" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ScrollViewer MaxHeight="100"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#FFF5CD" FontSize="13" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
     <Button Grid.Column="1" Content="×" Click="CloseNotice_Click" VerticalAlignment="Top" Padding="6,0" Style="{StaticResource QuietButton}" AutomationProperties.Name="Dismiss message"/>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Spacing="9" Padding="0,8,0,12">
    <ComboBox x:Name="ModeCombo" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Answer style">
     <ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Quick answer"/><ComboBoxItem Content="Teach me"/><ComboBoxItem Content="Troubleshoot"/><ComboBoxItem Content="Walkthrough"/>
    </ComboBox>
    <TextBox x:Name="QuestionBox" PlaceholderText="What does this do?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" PreviewKeyDown="QuestionBox_KeyDown" AutomationProperties.Name="Your question"/>
    <TextBlock Text="Shift+Enter to send · Enter for a new line" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Grid>
     <StackPanel Orientation="Horizontal" Spacing="7">
      <Button Content="Stop speech" Click="StopSpeech_Click" Padding="8,6"/>
      <Button x:Name="MicButton" Content="Mic" Click="Mic_Click" AutomationProperties.Name="Start or stop listening"/>
      <Button Content="New chat" Click="NewChat_Click"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7">
      <Button x:Name="CancelButton" Content="Stop" Click="Cancel_Click" Visibility="Collapsed"/>
      <Button x:Name="SendButton" Content="Ask  ↗" Click="Send_Click" Background="{StaticResource AccentBrush}" Foreground="#20271E" Padding="22,9"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" Visibility="Collapsed" Padding="26,12,26,24">
   <StackPanel Spacing="18">
    <TextBlock Text="Make yourself at home." FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="Your account, your screen, your call." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="AI account" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="AccountText" Text="Connect your ChatGPT account through Codex." TextWrapping="Wrap"/>
      <TextBox x:Name="CodexPathBox" Header="Codex executable" PlaceholderText="C:\path\to\codex.exe"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Connect / sign in" Click="Connect_Click"/><Button Content="Check" Click="CheckAccount_Click"/><Button Content="Log out" Click="Logout_Click"/></StackPanel>
      <ComboBox x:Name="ModelCombo" Header="Model" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ModelCombo_SelectionChanged"/>
      <TextBlock Text="Quick bubbles use GPT-6 Astra · Low reasoning." FontSize="12" TextWrapping="Wrap"/>
      <ComboBox x:Name="DetailEffortCombo" Header="Reasoning in the full window" SelectedIndex="0" SelectionChanged="DetailEffort_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="Medium — everyday explanations"/><ComboBoxItem Content="High — harder questions"/></ComboBox>
      <Button Content="Check usage" Click="Usage_Click" HorizontalAlignment="Left"/>
      <TextBlock x:Name="UsageText" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Tutorial shortcuts" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Ctrl+]: point at a control, then enter what you want to make or learn.&#x0a;Ctrl+Shift+]: draw a box, then enter your goal.&#x0a;Ctrl+Alt+Enter: check the current step and continue.&#x0a;No keywords needed. Follow one instruction at a time; Little Guy checks the screen before moving on." TextWrapping="Wrap" FontSize="13"/>
      <TextBlock Text="Streaming and recording" FontSize="17" FontWeight="SemiBold"/>
      <ToggleSwitch x:Name="StreamVisibilityToggle" Header="Show Little Guy in screen recordings" OnContent="Visible in captures" OffContent="Hidden from captures" Toggled="StreamVisibility_Changed"/>
      <TextBlock Text="Includes the window, smiley, speech bubbles, highlights and reply drafts. Changes apply immediately and are remembered." TextWrapping="Wrap" FontSize="13"/>
      <TextBlock Text="For a full demo in OBS, use Display Capture. Capturing only another app or game does not include Little Guy's separate windows. Hiding depends on the recording app honoring Windows capture exclusion." TextWrapping="Wrap" FontSize="12"/>
      <TextBlock x:Name="StreamVisibilityStatus" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Screen and privacy" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Attached screenshots and window context are sent to Codex for AI processing. Capture happens when you activate Little Guy or confirm a walkthrough step. No continuous recording." TextWrapping="Wrap" FontSize="13"/>
      <ToggleSwitch x:Name="ScreenToggle" Header="Attach the window I point at" Toggled="Settings_Changed"/>
      <TextBox x:Name="ExcludedBox" Header="Never capture these applications (one process name per line)" AcceptsReturn="True" MinHeight="100" TextChanged="Excluded_Changed"/>
      <ToggleSwitch x:Name="HistoryToggle" Header="Save conversation text locally" Toggled="Settings_Changed"/>
      <TextBlock Text="Text history is protected with your Windows account. Screenshots and recordings are not saved by Little Guy. Codex retention auditing is still in progress for this development build." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button Content="Delete local history" Click="DeleteHistory_Click"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Voice and character" FontSize="17" FontWeight="SemiBold"/>
      <ToggleSwitch x:Name="VoiceToggle" Header="Enable microphone while holding the shortcut" Toggled="Settings_Changed"/>
      <ToggleSwitch x:Name="SpeakToggle" Header="Speak answers aloud" Toggled="Settings_Changed"/>
      <ComboBox x:Name="NarrationVoiceCombo" Header="Speaking voice" HorizontalAlignment="Stretch" SelectionChanged="NarrationVoice_Changed"/>
      <TextBlock Text="Natural voices run on your PC. No subscription or per-use speech charges. The first preview may take a few seconds to load." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview voice" Click="PreviewVoice_Click"/><Button Content="Stop speech" Click="StopSpeech_Click"/></StackPanel>
      <Button Content="Little Guy voice · male + chipmunk" Click="ChipmunkVoice_Click"/>
      <Slider x:Name="SpeechPitchSlider" Header="Natural voice pitch · semitones" Minimum="-6" Maximum="12" StepFrequency="1" ValueChanged="SpeechPitch_Changed"/>
      <Slider x:Name="SpeechRateSlider" Header="Speaking speed" Minimum="-5" Maximum="5" StepFrequency="1" ValueChanged="SpeechRate_Changed"/>
      <TextBlock x:Name="VoiceInfo" TextWrapping="Wrap" FontSize="12"/>
      <ComboBox x:Name="MicrophoneCombo" Header="Microphone" HorizontalAlignment="Stretch" SelectionChanged="Microphone_Changed"/>
      <Button Content="Refresh microphones" Click="RefreshMicrophones_Click"/>
      <TextBlock Text="Hold to record; release to transcribe on your PC. English recognition. Audio stays in memory. Up to 60 seconds per request." TextWrapping="Wrap" FontSize="12"/>
      <ToggleSwitch x:Name="CompanionToggle" Header="Show the smiley beside my pointer" Toggled="Settings_Changed"/>
      <ToggleSwitch x:Name="MotionToggle" Header="Reduce motion" Toggled="Settings_Changed"/>
      <TextBlock Text="Character preview" FontWeight="SemiBold"/>
      <ComboBox x:Name="PreviewCombo" SelectedIndex="0" SelectionChanged="Preview_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="Idle"/><ComboBoxItem Content="Listening"/><ComboBoxItem Content="Thinking"/><ComboBoxItem Content="Speaking"/><ComboBoxItem Content="Guiding"/><ComboBoxItem Content="Success"/><ComboBoxItem Content="Error"/><ComboBoxItem Content="Paused"/></ComboBox>
      <Image x:Name="SettingsMascotImage" Width="110" Height="110" HorizontalAlignment="Left" AutomationProperties.Name="Smiley animation preview"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Reply drafts · Ctrl+Shift+R" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Click an empty reply box for one conversation, then press the shortcut. Multiple visible comments open a sticky list with editable drafts and Copy buttons. Little Guy never sends replies." TextWrapping="Wrap" FontSize="13"/>
      <TextBox x:Name="ReplyToneBox" Header="Tone guidelines" PlaceholderText="Your voice, length, language, emoji preferences…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxLength="4000" TextChanged="ReplyTone_Changed"/>
      <TextBlock Text="Draft from visible content on X, Facebook, Instagram, Reddit, WhatsApp, Telegram and other apps. Automatic insertion depends on the editor's accessibility support; a copyable draft is provided when the field cannot be safely filled." TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Research and ChatGPT" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Say: Research budget microphones and save to a Google Sheet. Little Guy opens a browser search, researches live sources through your connected account, and saves the report to Google Drive. Say Google Doc for a written report." TextWrapping="Wrap"/>
      <TextBlock Text="Google Drive needs a one-time Desktop OAuth client setup. Enable the Drive API in your Google Cloud project, download its Desktop app client JSON, then choose it below. Instructions: GOOGLE_DRIVE_SETUP.md beside the app." TextWrapping="Wrap" FontSize="12"/>
      <Button Content="Open Google setup" Click="GoogleSetup_Click"/>
      <TextBox x:Name="GoogleClientPathBox" Header="Google Desktop OAuth client JSON" IsReadOnly="True"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose JSON" Click="SelectGoogleClient_Click"/><Button Content="Connect Drive" Click="ConnectGoogle_Click"/><Button Content="Disconnect" Click="DisconnectGoogle_Click"/></StackPanel>
      <TextBlock x:Name="GoogleDriveStatus" TextWrapping="Wrap"/>
      <ComboBox x:Name="ResearchFormatCombo" Header="Save current report as" SelectedIndex="0"><ComboBoxItem Content="Google Doc"/><ComboBoxItem Content="Google Sheet"/></ComboBox>
      <Button Content="Save report" Click="SaveResearch_Click"/>
      <HyperlinkButton x:Name="ResearchLink" Content="Your saved document link appears here"/>
      <ScrollViewer MaxHeight="240"><TextBlock x:Name="ResearchResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
      <TextBlock Text="Say: Open ChatGPT, or Ask ChatGPT to help plan my project. The installed ChatGPT app opens a new chat with your request ready to send." TextWrapping="Wrap"/>
      <Button Content="Open a new ChatGPT chat" Click="OpenChatGpt_Click"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Ctrl+Shift+\ · Explain an interface&#x0a;Click, drag a yellow box and release. Little Guy explains the visible buttons, knobs, dials and components by section. Open the full answer for the complete breakdown. Esc or right-click cancels selection. The region is limited to the application at the box's center." TextWrapping="Wrap" FontSize="13"/>
    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18">
     <StackPanel Spacing="12">
      <TextBlock Text="Circle, speak and control" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Ctrl+Alt+C: circle an item, then hold your Ask shortcut to speak. Release to get an answer. The circled area's bounding rectangle is attached; you can also type in the bubble." TextWrapping="Wrap"/>
      <ToggleSwitch x:Name="CommandsToggle" Header="Allow explicit app and media commands" Toggled="Settings_Changed"/>
      <TextBlock Text="Hold Ctrl+Alt+Space, speak a command, then release. Commands can open Spotify, Notepad, Calculator, Explorer and Settings; play/pause/skip music; and search for songs or playlists in Spotify. Little Guy only activates a matching Play button when it can identify one. No general clicks, shell commands, deleting, purchases or sending messages." TextWrapping="Wrap" FontSize="12"/>
      <TextBox x:Name="CommandBox" Header="Try a typed command" PlaceholderText="Open Spotify, or play a song on Spotify"/>
      <Button Content="Run command" Click="RunCommand_Click"/>
     </StackPanel>
    </Border>
    <ToggleSwitch x:Name="HotkeyToggle" Header="Use Ctrl+Shift+Space instead of Ctrl+Space" Toggled="Settings_Changed"/>
    <TextBlock x:Name="HotkeyInfo" TextWrapping="Wrap" FontSize="12"/>
    <Button Content="Copy diagnostic summary" Click="CopyDiagnostics_Click"/>
    <TextBlock x:Name="BuildInfo" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" x:Name="HistoryPanel" Visibility="Collapsed" Padding="26,12,26,24" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Spacing="8"><TextBlock Text="Saved answers" FontSize="27"/><TextBox x:Name="HistorySearchBox" PlaceholderText="Search up to 500 recent saved answers…" TextChanged="HistorySearch_Changed"/><ToggleSwitch x:Name="HistoryPinnedOnly" Header="Pinned only" Toggled="HistoryPinned_Changed"/></StackPanel>
   <ScrollViewer Grid.Row="1"><StackPanel x:Name="HistoryItems" Spacing="18"/></ScrollViewer>
  </Grid>
  <Grid Grid.Row="3" Padding="26,10,26,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <TextBlock x:Name="StatusText" Text="Ready when you are." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,130,0"/>
   <TextBlock x:Name="ShortcutText" Text="CTRL + SPACE" HorizontalAlignment="Right" FontSize="11" CharacterSpacing="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
 </Grid>
</Window>
